{
  "check_for_updates": false,
  "active_keybinding_map": "vscode",
  "languages": {
    "r": {
      "extensions": [
        "R",
        "r",
        "Rprofile"
      ],
      "grammar": "R",
      "comment_prefix": "# ",
      "tab_size": 2,
      "use_tabs": false,
      "formatter": {
        "command": "air",
        "args": [
          "format",
          "--stdin-file-path",
          "$FILE"
        ],
        "stdin": true,
        "timeout_ms": 10000
      },
      "format_on_save": true,
      "auto_indent": true,
      "indent": {
        "increase_indent_pattern": "[\\{\\(\\[]\\s*$",
        "decrease_indent_pattern": "^\\s*[\\}\\)\\]]"
      }
    },
    "python": {
      "extensions": [
        "py",
        "pyi"
      ],
      "grammar": "python",
      "comment_prefix": "# ",
      "auto_indent": true,
      "tab_size": 4,
      "use_tabs": false,
      "formatter": {
        "command": "uvx",
        "args": [
          "ruff",
          "format",
          "--stdin-filename",
          "$FILE"
        ],
        "stdin": true,
        "timeout_ms": 20000
      },
      "format_on_save": true
    }
  },
  "lsp": {
    "r": {
      "name": "languageserver",
      "command": "corral",
      "args": [
        "_lsp"
      ],
      "enabled": true,
      "auto_start": true,
      "root_markers": [
        ".corral",
        "DESCRIPTION",
        "renv.lock",
        ".here",
        ".lintr",
        "air.toml",
        ".git"
      ],
      "except_features": [
        "format"
      ]
    },
    "python": [
      {
        "name": "pylsp",
        "command": "corral",
        "args": [
          "_lsp",
          "python"
        ],
        "enabled": true,
        "auto_start": true,
        "root_markers": [
          "pyproject.toml",
          "uv.lock",
          "setup.py",
          "setup.cfg",
          "requirements.txt",
          ".git"
        ],
        "except_features": [
          "diagnostics",
          "format",
          "code_action"
        ]
      },
      {
        "name": "ruff",
        "command": "corral",
        "args": [
          "_lsp",
          "ruff"
        ],
        "enabled": true,
        "auto_start": true,
        "root_markers": [
          "pyproject.toml",
          "uv.lock",
          "setup.py",
          "setup.cfg",
          "requirements.txt",
          ".git"
        ],
        "only_features": [
          "diagnostics",
          "code_action"
        ]
      }
    ]
  },
  "keybindings": [
    {
      "key": "s",
      "modifiers": [
        "ctrl"
      ],
      "action": "corral_save"
    },
    {
      "key": "r",
      "modifiers": [
        "ctrl"
      ],
      "action": "corral_run_line"
    },
    {
      "key": "Enter",
      "modifiers": [
        "ctrl"
      ],
      "action": "corral_run_line"
    },
    {
      "key": "Enter",
      "modifiers": [
        "alt"
      ],
      "action": "corral_run_line"
    },
    {
      "key": "F5",
      "action": "corral_run_file"
    },
    {
      "key": "Enter",
      "modifiers": [
        "ctrl",
        "shift"
      ],
      "action": "corral_run_file"
    },
    {
      "key": "l",
      "modifiers": [
        "ctrl"
      ],
      "action": "corral_insert_assign"
    },
    {
      "key": "minus",
      "modifiers": [
        "alt"
      ],
      "action": "corral_insert_assign"
    },
    {
      "key": "u",
      "modifiers": [
        "ctrl"
      ],
      "action": "corral_insert_pipe"
    },
    {
      "key": "m",
      "modifiers": [
        "ctrl",
        "shift"
      ],
      "action": "corral_insert_pipe"
    },
    {
      "key": "7",
      "modifiers": [
        "ctrl"
      ],
      "action": "toggle_comment"
    },
    {
      "key": "c",
      "modifiers": [
        "ctrl",
        "shift"
      ],
      "action": "toggle_comment"
    },
    {
      "key": "space",
      "modifiers": [
        "ctrl"
      ],
      "action": "lsp_completion"
    }
  ],
  "default_language": "r",
  "editor": {
    "completion_popup_auto_show": true,
    "quick_suggestions": true,
    "quick_suggestions_delay_ms": 200,
    "suggest_on_trigger_characters": true
  },
  "plugins": {
    "orchestrator": {
      "enabled": false
    },
    "workboard": {
      "enabled": false
    },
    "live_sessions": {
      "enabled": false
    },
    "agent_discovery": {
      "enabled": false
    },
    "agent_sessions": {
      "enabled": false
    },
    "agent_sessions_claude_code": {
      "enabled": false
    },
    "agent_sessions_codex": {
      "enabled": false
    },
    "agent_sessions_multiplexers": {
      "enabled": false
    },
    "agent_sessions_orchestrators": {
      "enabled": false
    },
    "agent_sessions_tmux": {
      "enabled": false
    },
    "dashboard": {
      "enabled": false
    },
    "welcome": {
      "enabled": false
    },
    "welcome_screen": {
      "enabled": false
    },
    "k8s-workspace": {
      "enabled": false
    },
    "devcontainer": {
      "enabled": false
    },
    "code-tour": {
      "enabled": false
    },
    "audit_mode": {
      "enabled": false
    },
    "csharp_support": {
      "enabled": false
    },
    "clangd_support": {
      "enabled": false
    },
    "deno_lsp": {
      "enabled": false
    },
    "asm-lsp": {
      "enabled": false
    },
    "slang-lsp": {
      "enabled": false
    }
  }
}
