#!/usr/bin/env python3
"""corral: glue between a terminal workspace, an R console and lightweight viewers.

The logic lives here so it works in any terminal. Inside herdr it uses the
herdr CLI to place things in panes and popups; outside herdr it runs inline.
Standard library only.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

VERSION = "0.1.0"
PLUGIN_ID = "corral"
SCRIPT = Path(__file__).resolve()
REPO = SCRIPT.parent.parent
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "corral"
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "corral" / "config.json"
KITTY_TERMINALS = ("wezterm", "kitty", "ghostty")
MIRADOR_INFO = STATE_DIR / "mirador.json"
MIRADOR_SERVER = REPO / "mirador" / "server.py"
RUST_CORRAL = REPO / "rs" / "target" / "release" / "corral"


def mirador_command() -> list[str]:
    """Mirador's server: the Rust one when built (a few MB), else the Python one."""
    if RUST_CORRAL.is_file() and os.access(RUST_CORRAL, os.X_OK):
        return [str(RUST_CORRAL), "_mirador"]
    return [sys.executable, str(MIRADOR_SERVER)]

# Windows browsers reachable from WSL, in default order. Firefox has no app mode,
# so it gets a new window; Edge and Chrome open one without tabs or address bar.
WINDOWS_BROWSERS = {
    "firefox": (
        ["/mnt/c/Program Files/Mozilla Firefox/firefox.exe",
         "/mnt/c/Program Files (x86)/Mozilla Firefox/firefox.exe"],
        ["--new-window", "{url}"],
    ),
    "edge": (
        ["/mnt/c/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
         "/mnt/c/Program Files/Microsoft/Edge/Application/msedge.exe"],
        ["--app={url}"],
    ),
    "chrome": (
        ["/mnt/c/Program Files/Google/Chrome/Application/chrome.exe"],
        ["--app={url}"],
    ),
}


class CorralError(Exception):
    pass


# --------------------------------------------------------------------------- herdr


def herdr_bin() -> str | None:
    return os.environ.get("HERDR_BIN_PATH") or shutil.which("herdr")


def in_herdr() -> bool:
    return os.environ.get("HERDR_ENV") == "1"


def herdr(*args: str) -> dict:
    """Run a herdr CLI command and return its JSON `result`."""
    hb = herdr_bin()
    if not hb:
        raise CorralError("herdr no está en el PATH")
    proc = subprocess.run([hb, *args], capture_output=True, text=True)
    out = proc.stdout.strip()
    try:
        data = json.loads(out) if out else {}
    except json.JSONDecodeError:
        data = {}
    if proc.returncode != 0 or "error" in data:
        err = data.get("error") or {}
        msg = err.get("message") or proc.stderr.strip() or out or f"herdr {' '.join(args)} falló"
        raise CorralError(msg)
    return data.get("result", data)


def plugin_context() -> dict:
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {}


def notify(title: str, body: str = "") -> None:
    """Show a herdr notification when possible; always echo to stderr."""
    print(f"corral: {title}{': ' + body if body else ''}", file=sys.stderr)
    if in_herdr():
        try:
            herdr("notification", "show", title, "--body", body or " ")
        except CorralError:
            pass


def current_workspace() -> str | None:
    ws = os.environ.get("HERDR_WORKSPACE_ID") or plugin_context().get("workspace_id")
    if ws:
        return ws
    try:
        for w in herdr("workspace", "list").get("workspaces", []):
            if w.get("focused"):
                return w["workspace_id"]
    except CorralError:
        pass
    return None


def current_pane() -> str | None:
    return (
        os.environ.get("HERDR_PANE_ID")
        or plugin_context().get("focused_pane_id")
        or os.environ.get("HERDR_ACTIVE_PANE_ID")
    )


def console_label(lang: str) -> str:
    return f"corral:{lang}"


def list_panes(workspace: str | None = None) -> list[dict]:
    args = ["pane", "list"] + (["--workspace", workspace] if workspace else [])
    return herdr(*args).get("panes", [])


def find_console(lang: str) -> str | None:
    """Console pane for `lang`: same workspace first, then any workspace."""
    label = console_label(lang)
    ws = current_workspace()
    for scope in ([ws] if ws else []) + [None]:
        for pane in list_panes(scope):
            if pane.get("label") == label:
                return pane["pane_id"]
    return None


# --------------------------------------------------------------------------- commands


def cmd_layout(args: argparse.Namespace) -> None:
    """New tab: agent on the left; on the right, script over console, variables below.

    Script and console share the upper area; `corral toggle` (ctrl+b t) gives it to
    one or the other, like tabs that keep a few lines of the other visible.
    """
    ws = current_workspace()
    if not ws:
        raise CorralError("no encontré un workspace de herdr")
    ctx = plugin_context()
    cwd = args.cwd or ctx.get("focused_pane_cwd") or ctx.get("workspace_cwd") or os.getcwd()

    try:
        theme_module().apply()  # herdr's theme rules every Corral window
    except Exception as exc:  # a theme problem must never block the layout
        print(f"corral: no pude aplicar el tema ({exc})", file=sys.stderr)
    tab = herdr("tab", "create", "--workspace", ws, "--label", args.label, "--cwd", cwd, "--focus")
    left = tab["root_pane"]["pane_id"]
    right = herdr(
        "pane", "split", left, "--direction", "right", "--ratio", str(args.ratio), "--cwd", cwd, "--no-focus"
    )["pane"]["pane_id"]

    # Only one of each per workspace: take the labels away from older panes.
    label = console_label("r")
    for pane in list_panes(ws):
        if pane.get("label") in (label, console_label("python"), "corral:vars", "corral:script"):
            herdr("pane", "rename", pane["pane_id"], "--clear")
    saved, state = layout_state(ws)
    state.clear()
    save_layout_state(saved)

    # Right column: [script over console] over variables.
    vars_pane = split_vars_pane(right, ratio=0.73)
    editor = args.editor if args.editor and shutil.which(shlex.split(args.editor)[0]) else ""
    if editor:
        console = herdr("pane", "split", right, "--direction", "down", "--ratio", str(SCRIPT_SHARE), "--cwd", cwd,
                        "--no-focus")["pane"]["pane_id"]
        herdr("pane", "rename", right, "corral:script")
        herdr("pane", "run", right, editor_command(editor, scratch_script(ws, cwd)))
    else:
        console = right
    herdr("pane", "rename", console, label)
    herdr("pane", "run", console, args.console or console_command("r"))

    if args.shell:
        shell = herdr(
            "pane", "split", vars_pane, "--direction", "right", "--ratio", "0.5", "--cwd", cwd, "--no-focus"
        )["pane"]["pane_id"]
        herdr("pane", "rename", shell, "corral:shell")

    if args.agent:
        herdr("pane", "run", left, args.agent)
    print(json.dumps({"tab": tab["tab"]["tab_id"], "agent": left, "console": console,
                      "script": right if editor else None, "vars": vars_pane}))


SCRATCH_ROOT = Path(os.environ.get("XDG_RUNTIME_DIR") or Path.home() / ".cache") / "corral" / "borradores"
SCRATCH_INDEX = STATE_DIR / "borradores.json"
SCRATCH_MAX_AGE = 2 * 86400


def scratch_root(project: str | None) -> Path:
    """Where scratch files go: <project>/.corral/ (so Air, lintr and the language
    server see the project), or a temp folder when there is no project to speak of."""
    if project:
        root = Path(project).expanduser().resolve()
        if root not in (Path.home().resolve(), Path("/")) and os.access(root, os.W_OK):
            return root / ".corral"
    return SCRATCH_ROOT


def scratch_script(workspace: str | None, project: str | None = None) -> Path:
    """A new, empty .R file for the script pane, thrown away unless you save it.

    It must be a real file because the editor only offers completion on saved
    files. Old ones (more than two days) are removed here.
    """
    label = "corral"
    try:
        for w in herdr("workspace", "list").get("workspaces", []):
            if w.get("workspace_id") == workspace:
                label = w.get("label") or label
    except CorralError:
        pass
    label = re.sub(r"[^A-Za-z0-9._-]+", "-", label).strip("-") or "corral"
    root = scratch_root(project)
    root.mkdir(parents=True, exist_ok=True)
    if root.name == ".corral":
        # Git ignores the whole folder without touching the project's .gitignore.
        ignore = root / ".gitignore"
        if not ignore.exists():
            ignore.write_text("# Borradores temporales de Corral\n*\n")
    for old in root.iterdir():
        try:
            if old.is_dir() and time.time() - old.stat().st_mtime > SCRATCH_MAX_AGE:
                shutil.rmtree(old, ignore_errors=True)
        except OSError:
            pass
    folder = root / f"{label}-{time.strftime('%Y%m%d-%H%M%S')}"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / "borrador.R"
    path.write_text("", encoding="utf-8")
    index = read_json_file(SCRATCH_INDEX)
    index[workspace or "default"] = str(path)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    SCRATCH_INDEX.write_text(json.dumps(index))
    return path


def read_json_file(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def editor_command(editor: str, target: Path | str) -> str:
    """Command line for the script pane. Fresh starts clean (--no-restore), without old tabs."""
    is_fresh = any(Path(t).name == "fresh" for t in shlex.split(editor))
    extra = " --no-restore" if is_fresh else ""
    # WSLg's Wayland has no clipboard protocol for Fresh: it warns and falls back
    # to X11 anyway, so start it on X11 directly.
    prefix = "env -u WAYLAND_DISPLAY " if is_fresh and os.environ.get("WSL_DISTRO_NAME") and os.environ.get("DISPLAY") else ""
    return f"{prefix}{editor}{extra} {shlex.quote(str(target))}"


def scratch_text(scratch: str) -> str:
    """Latest text of a scratch file: the editor plugin's live copy if newer, else the file."""
    path = Path(scratch)
    live = path.with_name(".actual.R")
    candidates = [p for p in (live, path) if p.exists()]
    if not candidates:
        return ""
    newest = max(candidates, key=lambda p: p.stat().st_mtime)
    return newest.read_text(encoding="utf-8")


def herdr_socket(method: str, params: dict) -> dict:
    """Raw socket call, for the few methods the herdr CLI does not expose."""
    import socket as _socket
    path = os.environ.get("HERDR_SOCKET_PATH") or str(Path.home() / ".config" / "herdr" / "herdr.sock")
    with _socket.socket(_socket.AF_UNIX) as sock:
        sock.settimeout(5)
        sock.connect(path)
        sock.sendall(json.dumps({"id": "corral", "method": method, "params": params}).encode() + b"\n")
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
    data = json.loads(buf or b"{}")
    if "error" in data:
        raise CorralError(data["error"].get("message", "herdr falló"))
    return data.get("result", {})


def find_labeled(label: str) -> str | None:
    for pane in list_panes(current_workspace()):
        if pane.get("label") == label:
            return pane["pane_id"]
    return None


def split_between(node: dict, a: str, b: str, path: list[bool]) -> tuple[list[bool], dict, bool] | None:
    """Path to the split that separates panes a and b; True if a is in its first half."""
    if node.get("type") != "split":
        return None
    def has(n: dict, pid: str) -> bool:
        if n.get("type") == "pane":
            return n.get("pane_id") == pid
        return has(n["first"], pid) or has(n["second"], pid)
    first, second = node["first"], node["second"]
    if has(first, a) and has(second, b):
        return path, node, True
    if has(first, b) and has(second, a):
        return path, node, False
    for i, child in enumerate((first, second)):
        if has(child, a) and has(child, b):
            return split_between(child, a, b, path + [bool(i)])
    return None


TOGGLE_NAMES = {"ambos": "Script y consola", "script": "Script", "consola": "Consola"}
LANG_NAMES = {"r": "R", "python": "Python"}
PARKING_TAB = "corral (oculto)"
OLD_PARKING_TABS = ("consola (oculta)", "script (oculto)")
EXPANDED_FILE = STATE_DIR / "expandido.json"  # per workspace: the active console, and what ctrl+b t hid
SCRIPT_SHARE = 0.57


def layout_state(ws: str | None) -> tuple[dict, dict]:
    """All workspaces' layout state, and this workspace's own (modify it, then save)."""
    saved = read_json_file(EXPANDED_FILE)
    return saved, saved.setdefault(ws or "default", {})


def save_layout_state(saved: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    EXPANDED_FILE.write_text(json.dumps(saved))


def main_tab(panes: list[dict]) -> str | None:
    """The tab of the Corral layout: where the variables pane (or the script) is."""
    for label in ("corral:vars", "corral:script"):
        for p in panes:
            if p.get("label") == label:
                return p.get("tab_id")
    return None


def active_lang(ws: str | None = None, panes: list[dict] | None = None) -> str:
    """The language of the console in the layout's console spot: R unless you switched."""
    ws = ws or current_workspace()
    lang = layout_state(ws)[1].get("active", "r")
    if lang != "r":
        panes = panes if panes is not None else list_panes(ws)
        if not any(p.get("label") == console_label(lang) for p in panes):
            return "r"
    return lang


def hidden_tab(ws: str | None) -> tuple[str | None, str | None]:
    """The workspace's tab for hidden panes, and one pane in it."""
    if not ws:
        return None, None
    tabs = herdr("tab", "list", "--workspace", ws).get("tabs", [])
    tab = next((t["tab_id"] for t in tabs if t.get("label") == PARKING_TAB), None)
    pane = next((p["pane_id"] for p in list_panes(ws) if p.get("tab_id") == tab), None) if tab else None
    return tab, pane


def park(pane: str, ws: str | None) -> None:
    """Move a pane out of sight, to the workspace's hidden tab, where it keeps running."""
    tab, other = hidden_tab(ws)
    if tab and other:
        destination = {"type": "tab", "tab_id": tab, "split": "right", "target_pane_id": other}
    else:
        destination = {"type": "new_tab", "label": PARKING_TAB}
        if ws:
            destination["workspace_id"] = ws
    herdr_socket("pane.move", {"pane_id": pane, "focus": False, "destination": destination})


ARK_VERSION = "0.1.252"  # the version Corral was tested with
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "corral"
ARK_DIR = DATA_DIR / "ark"
JUPYTER_DIR = DATA_DIR / "jupyter"  # Corral's own kernel spec; your Jupyter setup stays as it is


def ark_binary() -> Path | None:
    """The newest Ark installed under ~/.local/share/corral/ark (or corral config ark_bin)."""
    configured = corral_config().get("ark_bin")
    if configured and Path(configured).is_file():
        return Path(configured)
    found = [d / "ark" for d in ARK_DIR.glob("*") if (d / "ark").is_file()]
    key = lambda f: [int(x) if x.isdigit() else 0 for x in f.parent.name.split(".")]  # noqa: E731
    return max(found, key=key) if found else None


def jupyter_frontend() -> bool:
    """Ark through jupyter-console (ark_frontend: jupyter, or Corral's Rust console not built)."""
    return corral_config().get("ark_frontend") == "jupyter" or not RUST_CORRAL.is_file()


def r_flavor() -> str:
    """How the R console runs: "ark" (Positron's kernel, the default when installed) or "r"."""
    choice = corral_config().get("r_console") or "ark"
    frontend = not jupyter_frontend() or shutil.which("jupyter-console")
    if choice == "ark" and frontend and ark_binary() and shutil.which("R"):
        return "ark"
    return "r"


def ark_kernelspec() -> Path:
    """Write Corral's kernel spec for Ark (R_HOME and R's library path, like the R script sets them)."""
    ark = ark_binary()
    probe = subprocess.run(["R", "--vanilla", "--no-echo", "-e",
                            'cat(R.home(), Sys.getenv("LD_LIBRARY_PATH"), sep = "\\n")'],
                           capture_output=True, text=True, timeout=30)
    r_home, _, ld_path = probe.stdout.strip().partition("\n")
    spec = {
        "argv": [str(ark), "--connection_file", "{connection_file}", "--session-mode", "console",
                 "--default-repos", "none", "--log", str(STATE_DIR / "ark.log")],
        "display_name": "R (Ark, Corral)",
        "language": "R",
        "env": {"R_HOME": r_home, "LD_LIBRARY_PATH": ld_path or f"{r_home}/lib"},
    }
    folder = JUPYTER_DIR / "kernels" / "ark"
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "kernel.json").write_text(json.dumps(spec, indent=1))
    return JUPYTER_DIR


def corral_command() -> str:
    """How to call corral from a pane: `corral` on the PATH (the Rust one when built), else this script."""
    found = shutil.which("corral")
    if found and Path(found).resolve() in (SCRIPT, (REPO / "rs" / "target" / "release" / "corral").resolve()):
        return "corral"
    return shlex.quote(str(SCRIPT))


def console_command(lang: str) -> str:
    """What corral types in a console pane: a short command that clears the screen and starts it."""
    return f"{corral_command()} _console {lang}"


def cmd_console_run(args: argparse.Namespace) -> None:
    """Start a console in this pane (R, Ark or IPython), on a clean screen."""
    sys.stdout.write("\033[H\033[2J\033[3J")  # the command corral typed goes away
    sys.stdout.flush()
    cfg = corral_config()
    env = dict(os.environ, CORRAL="1")
    if args.lang == "python":
        if cfg.get("python_console"):
            os.execvpe("sh", ["sh", "-c", cfg["python_console"]], env)
        os.execvpe("uv", ["uv", "run", "--with", "ipython", "ipython", "--no-banner", "-i",
                          str(REPO / "py" / "startup.py")], env)
    custom = cfg.get("r_console")
    if custom and custom not in ("ark", "r"):
        os.execvpe("sh", ["sh", "-c", custom], env)  # your own command
    if r_flavor() == "ark" and not jupyter_frontend():
        os.execve(str(RUST_CORRAL), [str(RUST_CORRAL), "_console", "r"], env)  # Corral's own console
    if r_flavor() == "ark":
        # Ark through jupyter-console. The connection file goes where corral.R can
        # announce it, so `corral _lsp r` can reach Ark's language server.
        folder = STATE_DIR / "ark"
        folder.mkdir(parents=True, exist_ok=True)
        for old in folder.glob("kernel-*.json"):
            if time.time() - old.stat().st_mtime > SCRATCH_MAX_AGE:
                old.unlink(missing_ok=True)
        conn = str(folder / f"kernel-{secrets.token_hex(4)}.json")
        env.update(CORRAL_ARK_CONNECTION=conn, JUPYTER_PATH=str(ark_kernelspec()))
        os.execvpe("jupyter-console", ["jupyter-console", "--kernel", "ark",
                                       f"--ConnectionFileMixin.connection_file={conn}",
                                       "--ZMQTerminalInteractiveShell.banner="], env)
    os.execvpe("R", ["R", "--quiet", "--no-save"], env)


def start_console(lang: str, ws: str | None, cwd: str, near: str | None) -> str:
    """A new console pane: under `near`, or in the hidden tab."""
    if near:
        pane = herdr("pane", "split", near, "--direction", "down", "--ratio", "0.5", "--cwd", cwd,
                     "--no-focus")["pane"]["pane_id"]
    else:
        _, other = hidden_tab(ws)
        if other:
            pane = herdr("pane", "split", other, "--direction", "right", "--cwd", cwd, "--no-focus")["pane"]["pane_id"]
        else:
            pane = herdr("tab", "create", "--label", PARKING_TAB, "--cwd", cwd,
                         *(["--workspace", ws] if ws else []))["root_pane"]["pane_id"]
    herdr("pane", "rename", pane, console_label(lang))
    herdr("pane", "run", pane, console_command(lang))
    return pane


def show_console(lang: str, start: bool = True, cwd: str | None = None) -> tuple[str | None, bool]:
    """Put `lang`'s console in the layout's console spot, starting it if needed.

    The console it replaces goes to the hidden tab and keeps running. Returns the
    pane and whether it was just started.
    """
    ws = current_workspace()
    panes = list_panes(ws)
    by_label = {p.get("label"): p for p in panes if p.get("label")}
    saved, state = layout_state(ws)
    current = active_lang(ws, panes)
    target = by_label.get(console_label(lang), {}).get("pane_id")
    other = by_label.get(console_label(current), {}) if current != lang else {}
    main = main_tab(panes)
    visible = other.get("pane_id") if other and main and other.get("tab_id") == main else None
    focused = current_pane()
    started = False

    if not target:
        if not start:
            return None, False
        project = cwd or other.get("foreground_cwd") or other.get("cwd") or os.getcwd()
        # Without a Corral layout, the new console just goes under the other one.
        near = visible or (other.get("pane_id") if not main else None)
        target = start_console(lang, ws, project, near=near)
        started = True
        if visible:
            park(visible, ws)
    elif visible:
        herdr_socket("pane.move", {"pane_id": target, "focus": False, "destination": {
            "type": "tab", "tab_id": main, "split": "down", "target_pane_id": visible, "ratio": 0.5}})
        park(visible, ws)
    # With the script expanded (ctrl+b t), the console stays hidden; ctrl+b t brings back this one.
    if other and state.get("parked") == other.get("pane_id"):
        state["parked"] = target
    if visible and focused == visible:
        herdr_socket("pane.focus", {"pane_id": target})
    state["active"] = lang
    save_layout_state(saved)
    return target, started


SHELLS = ("bash", "zsh", "fish", "sh", "dash")


def ensure_running(pane: str, lang: str) -> bool:
    """If the console was quit (q() or exit) and only its shell is left, start it again."""
    if any(s.get("pane_id") == pane for s in r_sessions()):
        return False
    try:
        procs = herdr("pane", "process-info", "--pane", pane).get("process_info", {}).get("foreground_processes", [])
    except CorralError:
        return False
    names = [str(p.get("name", "")) for p in procs]
    # Only a shell waiting at an empty prompt: a command just typed there is still starting.
    if names and all(n in SHELLS for n in names) and re.search(r"[$#%❯]\s*$", last_line(pane)):
        herdr("pane", "run", pane, console_command(lang))
        return True
    return False


def cmd_switch(args: argparse.Namespace) -> None:
    """The console spot shows R or Python (ctrl+b y); without a language, the other one."""
    current = active_lang()
    lang = args.lang or ("python" if current == "r" else "r")
    pane, started = show_console(lang)
    if pane and not started:
        started = ensure_running(pane, lang)
    notify("Consola", LANG_NAMES[lang] + (": iniciando (la primera vez uv prepara el entorno)" if started else ""))


def script_split(script: str, console: str) -> tuple[str, list, bool, float] | None:
    """Tab, split path, whether the script comes first, and the script's share of the split."""
    layout = herdr_socket("layout.export", {"pane_id": console})["layout"]
    found = split_between(layout["root"], script, console, [])
    if not found:
        return None
    path, node, script_first = found
    return layout["tab_id"], path, script_first, (node["ratio"] if script_first else 1 - node["ratio"])


def cmd_toggle(args: argparse.Namespace) -> None:
    """The upper right area for the script, the console, or both (ctrl+b t).

    herdr won't make a split smaller than 10 %, so expanding one moves the other
    to a tab of its own, where it keeps running. Back to both, it returns to its
    place with the proportion it had. Without a mode, ctrl+b t expands the pane
    you are in, and puts both back when one is expanded.
    """
    ws = current_workspace()
    panes = {p["pane_id"]: p for p in list_panes(ws)}
    by_label = {p.get("label"): pid for pid, p in panes.items()}
    script, console = by_label.get("corral:script"), by_label.get(console_label(active_lang(ws, list(panes.values()))))
    if not script or not console:
        notify("Sin script", "Este workspace no tiene panel de script; usa ctrl+b a o 'corral script'")
        return
    saved, state = layout_state(ws)

    if panes[script].get("tab_id") == panes[console].get("tab_id"):
        current, parked = "ambos", None
    else:
        parked = state.get("parked") if state.get("parked") in (script, console) else None
        if not parked:
            # The variables pane stays with the visible one.
            home = panes.get(by_label.get("corral:vars") or "", {}).get("tab_id")
            parked = script if panes[console].get("tab_id") == home else console
        current = "script" if parked == console else "consola"

    if args.mode:
        mode = args.mode
    elif current != "ambos":
        mode = "ambos"
    else:
        mode = "consola" if current_pane() == console else "script"
    if mode == current:
        notify("Corral", TOGGLE_NAMES[mode])
        return

    focused = current_pane()
    if parked:
        # Back to both, script above the console.
        share = state.get("share", SCRIPT_SHARE)
        visible = script if parked == console else console
        tab = panes[visible]["tab_id"]
        if parked == console:
            herdr_socket("pane.move", {"pane_id": console, "focus": False, "destination": {
                "type": "tab", "tab_id": tab, "target_pane_id": script, "split": "down", "ratio": share}})
        else:
            herdr_socket("pane.move", {"pane_id": script, "focus": False, "destination": {
                "type": "tab", "tab_id": tab, "target_pane_id": console, "split": "down", "ratio": 1 - share}})
            herdr_socket("pane.swap", {"source_pane_id": script, "target_pane_id": console})
            found = script_split(script, console)
            if found:
                herdr_socket("layout.set_split_ratio", {"tab_id": found[0], "path": found[1],
                                                        "ratio": share if found[2] else 1 - share})
        if focused in (script, console):  # the swap can move the focus; keep it where you were
            herdr_socket("pane.focus", {"pane_id": focused})
        state.pop("parked", None)
        state.pop("share", None)

    if mode != "ambos":
        keep, hide = (script, console) if mode == "script" else (console, script)
        found = script_split(script, console)
        share = found[3] if found else SCRIPT_SHARE
        if not 0.15 <= share <= 0.85:  # left over from the old 86/14 toggle
            share = SCRIPT_SHARE
        park(hide, ws)
        herdr_socket("pane.focus", {"pane_id": keep})
        state.update(parked=hide, share=share)

    save_layout_state(saved)
    notify("Corral", TOGGLE_NAMES[mode] + (" (ctrl+b t para volver)" if mode != "ambos" else ""))


def cmd_script(args: argparse.Namespace) -> None:
    """Add the script editor above the console, or save/read the scratch script."""
    if args.guardar or args.leer:
        scratch = read_json_file(SCRATCH_INDEX).get(current_workspace() or "default")
        if not scratch:
            raise CorralError("este workspace no tiene un borrador de Corral")
        text = scratch_text(scratch)
        if args.leer:
            print(text, end="" if text.endswith("\n") else "\n")
            return
        target = Path(args.guardar).expanduser()
        if not target.is_absolute():
            target = Path.cwd() / target
        if target.exists() and not args.forzar:
            raise CorralError(f"{target} ya existe; usa --forzar para reemplazarlo")
        target.parent.mkdir(parents=True, exist_ok=True)
        body = text
        if body and not body.endswith("\n"):
            body += "\n"
        target.write_text(body, encoding="utf-8")
        print(f"borrador guardado en {target}")
        return

    if find_labeled("corral:script"):
        notify("Script", "ya hay un panel de script en este workspace")
        return
    console = find_console("r")
    if not console:
        raise CorralError("no hay consola corral:r en este workspace")
    editor = args.editor
    if not shutil.which(shlex.split(editor)[0]):
        raise CorralError(f"no encuentro el editor '{editor}'")
    new = herdr("pane", "split", console, "--direction", "down", "--ratio", "0.45", "--no-focus")["pane"]["pane_id"]
    herdr("pane", "swap", "--source-pane", new, "--target-pane", console)
    herdr("pane", "rename", new, "corral:script")
    project = plugin_context().get("focused_pane_cwd") or os.getcwd()
    herdr("pane", "run", new, editor_command(editor, args.file or scratch_script(current_workspace(), project)))


CORRAL_LABELS = ("corral:script", "corral:r", "corral:python", "corral:vars", "corral:shell")


def cmd_close(args: argparse.Namespace) -> None:
    """Close Corral's panes (script, console, variables) and keep everything else, Claude included."""
    pane = current_pane()
    tab = plugin_context().get("tab_id") or os.environ.get("HERDR_TAB_ID")
    if not tab and pane:
        try:
            tab = herdr("pane", "get", pane).get("pane", {}).get("tab_id")
        except CorralError:
            tab = None
    panes = list_panes(current_workspace())
    if tab:
        panes = [p for p in panes if p.get("tab_id") == tab]
    targets = [p for p in panes if p.get("label") in CORRAL_LABELS]
    # Panes hidden by ctrl+b t or by the R/Python switch live in a tab of their own.
    ws = current_workspace()
    tabs = herdr("tab", "list", "--workspace", ws).get("tabs", []) if ws else []
    hidden = {t["tab_id"] for t in tabs if t.get("label") in (PARKING_TAB, *OLD_PARKING_TABS)}
    targets += [p for p in list_panes(ws)
                if p.get("tab_id") in hidden and p.get("label") in CORRAL_LABELS and p not in targets]
    saved = read_json_file(EXPANDED_FILE)
    parked = saved.pop(ws or "default", None) is not None
    if not targets:
        notify("Corral", "no hay paneles de Corral en esta pestaña")
        return
    scratch = read_json_file(SCRATCH_INDEX).get(current_workspace() or "default")
    for p in targets:
        try:
            herdr("pane", "close", p["pane_id"])
        except CorralError:
            pass
    if parked:
        save_layout_state(saved)
    note = f"{len(targets)} paneles cerrados"
    if scratch and Path(scratch).exists():
        note += "; el borrador queda unos días en " + str(Path(scratch).parent)  # in .corral/ when there's a project
    notify("Corral cerrado", note)
    print(note)


def cmd_console(args: argparse.Namespace) -> None:
    """Mark a pane (the current one by default) as the R or Python console."""
    pane = args.pane or current_pane()
    if not pane:
        raise CorralError("no sé qué panel marcar; usa --pane")
    try:
        procs = herdr("pane", "process-info", "--pane", pane).get("process_info", {}).get("foreground_processes", [])
    except CorralError:
        procs = []
    names = [str(p.get("name", "")) for p in procs]
    known = next((s.get("lang", "r") for s in r_sessions() if s.get("pane_id") == pane), None)
    is_ark = any(n.startswith("jupyter-consol") or n == "ark" for n in names)
    is_python = not is_ark and any(n in ("ipython", "python", "python3") or n.startswith("python3.") for n in names)
    lang = args.lang or known or ("python" if is_python else "r")
    label = console_label(lang)
    for other in list_panes(current_workspace()):
        if other.get("label") == label and other["pane_id"] != pane:
            herdr("pane", "rename", other["pane_id"], "--clear")
    herdr("pane", "rename", pane, label)
    # If R or IPython is already running there without Corral, switch it on.
    activated = False
    has_session = any(s.get("pane_id") == pane for s in r_sessions())
    if not has_session and lang == "r" and (is_ark or any(n == "R" for n in names)):
        herdr("pane", "run", pane, 'if (exists("corral_activar")) corral_activar()')
        activated = True
    elif not has_session and lang == "python" and is_python:
        herdr("pane", "run", pane, f'%run -i "{REPO / "py" / "startup.py"}"')
        activated = True
    saved, state = layout_state(current_workspace())
    state["active"] = lang
    save_layout_state(saved)
    notify("Consola marcada", f"{pane} es ahora {label}" + (" y Corral quedó activo" if activated else ""))


def read_clipboard() -> str:
    """System clipboard. In WSL, WSLg shares the Windows clipboard with Wayland and X11."""
    custom = os.environ.get("CORRAL_CLIPBOARD")
    candidates: list[list[str]] = [shlex.split(custom)] if custom else []
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
        candidates.append(["wl-paste", "--no-newline"])
    if os.environ.get("DISPLAY") and shutil.which("xclip"):
        candidates.append(["xclip", "-o", "-selection", "clipboard"])
    if os.environ.get("WSL_DISTRO_NAME") and shutil.which("powershell.exe"):  # slow (~2 s), last resort
        candidates.append(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command",
                           "[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Clipboard -Raw"])
    for argv in candidates:
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=5,
                                  cwd="/mnt/c" if argv[0].endswith(".exe") else None,
                                  env=windows_env() if argv[0].endswith(".exe") else None)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.replace("\r\n", "\n")
    return ""


def cmd_send(args: argparse.Namespace) -> None:
    """Send code to the console.

    Sources, in order: arguments, stdin, the herdr selection, the clipboard.
    herdr copies a selection to the clipboard and clears it on mouse release,
    so from a keybinding the clipboard is the usual source.
    """
    from_plugin = bool(os.environ.get("HERDR_PLUGIN_ID"))
    text, source = "", ""
    if args.text:
        text, source = " ".join(args.text), "argumentos"
    if not text.strip() and not from_plugin and not sys.stdin.isatty():
        text, source = sys.stdin.read(), "stdin"
    if not text.strip():
        text, source = plugin_context().get("selected_text") or "", "selección"
    if not text.strip() and (from_plugin or args.clipboard):
        text, source = read_clipboard(), "portapapeles"
    text = text.rstrip()
    if not text.strip():
        notify("Nada que enviar", "Selecciona código (se copia solo) y vuelve a intentar")
        return
    lang = args.lang or active_lang()
    pane, started = show_console(lang)
    if not pane:
        notify("Sin consola", f"No hay panel {console_label(lang)}. Usa 'corral layout' (ctrl+b a)")
        sys.exit(1)
    if not started:  # just opened: it is still starting, not quit
        started = ensure_running(pane, lang)
    if started:
        wait_for_prompt(pane, 180, lang)
    if args.source:
        # A whole script: run a temp file instead of pasting every line.
        run_dir = STATE_DIR / "run"
        run_dir.mkdir(parents=True, exist_ok=True)
        for old_file in [*run_dir.glob("*.R"), *run_dir.glob("*.py")]:  # keep a day of history, no more
            if time.time() - old_file.stat().st_mtime > 86400:
                old_file.unlink(missing_ok=True)
        stamp = f"{time.strftime('%H%M%S')}-{secrets.token_hex(3)}"
        label = Path(args.name).name if args.name else "script"
        if lang == "python":
            tmp = run_dir / f"{stamp}-{re.sub(r'[^A-Za-z0-9._-]', '-', label)}"
            tmp = tmp.with_suffix(".py")
            tmp.write_text(text + "\n", encoding="utf-8")
            text = f'%run -i "{tmp}"'
        else:
            tmp = run_dir / f"{stamp}.R"
            tmp.write_text(text + "\n", encoding="utf-8")
            text = f'source("{tmp}", echo = TRUE, max.deparse.length = Inf, encoding = "UTF-8")  # {label}'
        herdr("pane", "run", pane, text)
    elif lang == "python" or jupyter_prompt(pane):
        paste_python(pane, text)
    else:
        herdr("pane", "run", pane, text)
    lines = text.count("\n") + 1
    print(f"corral: enviado a {pane} desde {source} ({lines} línea{'s' if lines != 1 else ''})", file=sys.stderr)


def jupyter_prompt(pane: str) -> bool:
    """Is this console a Jupyter-style one (IPython, or R through Ark's jupyter-console)?"""
    for s in r_sessions():
        if s.get("pane_id") == pane:
            return s.get("lang") == "python" or bool(s.get("ark_connection"))
    return bool(re.match(r"(In \[\d+\]:|\s+\.\.\.:)", last_line(pane)))


def paste_python(pane: str, code: str) -> None:
    """Paste code into IPython or Ark's console as one block (bracketed paste) and run it, in one write."""
    last = code.rstrip("\n").splitlines()[-1] if code.strip() else ""
    enter = "\r\r" if last[:1] in (" ", "\t") else "\r"  # inside a block, an empty line closes it
    herdr_socket("pane.send_text", {"pane_id": pane, "text": "\x1b[200~" + code + "\x1b[201~" + enter})


def cmd_view(args: argparse.Namespace) -> None:
    """Open a table file in Mirador, in a herdr popup, or inline."""
    path = Path(args.file).expanduser().resolve()
    if not path.is_file():
        raise CorralError(f"no existe {path}")
    title = args.title or path.name

    # auto: inside herdr everything opens in herdr; elsewhere Mirador if it is running.
    target = os.environ.get("CORRAL_VIEW", "auto")
    use_mirador = target == "mirador" or (target == "auto" and not in_herdr() and mirador_alive())
    if not args.inline and use_mirador:
        info = ensure_mirador()
        mirador_call(info, "/api/tables", {"path": str(path), "title": title, "session": args.session})
        if not mirador_alive(info, need_window=True):
            open_mirador_window(info)
        return

    if in_herdr() and not args.inline:
        try:
            open_popup("table", {"CORRAL_FILE": str(path), "CORRAL_TITLE": title})
            return
        except CorralError as exc:
            # Plugin not linked or popup unavailable: fall back to a split pane.
            print(f"corral: popup no disponible ({exc}); abro un panel", file=sys.stderr)
        target = current_pane()
        split_args = ["pane", "split"] + ([target] if target else ["--current"])
        new = herdr(*split_args, "--direction", "right", "--ratio", "0.4", "--focus")["pane"]["pane_id"]
        herdr("pane", "rename", new, f"tabla: {title}")
        viewer = f"CORRAL_TITLE={shlex.quote(title)} {corral_command()} _table {shlex.quote(str(path))}; exit"
        herdr("pane", "run", new, viewer)
        return

    if RUST_CORRAL.is_file() and not os.environ.get("CORRAL_TABLE_VIEWER"):
        os.environ["CORRAL_TITLE"] = title
        os.execv(str(RUST_CORRAL), [str(RUST_CORRAL), "_table", str(path)])  # the DuckDB viewer
    run_table_viewer(path)


def run_table_viewer(path: Path) -> None:
    """Replace this process with the best table viewer available (without the Rust one)."""
    custom = os.environ.get("CORRAL_TABLE_VIEWER")
    if custom:
        argv = [a.replace("{file}", str(path)) for a in shlex.split(custom)]
        if "{file}" not in custom:
            argv.append(str(path))
        os.execvp(argv[0], argv)
    if shutil.which("vd"):
        os.execvp("vd", ["vd", "--config", str(REPO / "lib" / "corral.visidatarc"), str(path)])
    if shutil.which("duckdb"):
        rows = os.environ.get("CORRAL_MAX_ROWS", "1000")
        sql = f"SELECT * FROM {sql_literal(str(path))} LIMIT {int(rows)}"
        pipeline = (
            f"duckdb -box -cmd '.maxrows {int(rows)}' -cmd '.maxwidth 0' -c {shlex.quote(sql)}"
            " | less -S -R"
        )
        os.execvp("sh", ["sh", "-c", pipeline])
    raise CorralError("no hay visor de tablas: instala VisiData (vd) o DuckDB")


def sql_literal(s: str) -> str:
    return "'" + s.replace("'", "''") + "'"


def cmd_table(args: argparse.Namespace) -> None:
    file = args.file or os.environ.get("CORRAL_FILE")
    if not file:
        raise CorralError("falta el archivo (argumento o CORRAL_FILE)")
    run_table_viewer(Path(file))


def cmd_open(args: argparse.Namespace) -> None:
    """Open a URL (quarto preview, httpgd, a clicked link) in the browser; without one, Mirador."""
    url = args.url or os.environ.get("HERDR_PLUGIN_CLICKED_URL")
    if not url:
        open_mirador_window(ensure_mirador())
        return
    open_app_window(url)


# --------------------------------------------------------------------------- viewers inside herdr


def open_popup(entrypoint: str, env: dict[str, str]) -> None:
    """Open one of the plugin's popups. Retries while another modal is still closing."""
    args = ["plugin", "pane", "open", "--plugin", PLUGIN_ID, "--entrypoint", entrypoint,
            "--placement", "popup", "--focus"]
    for k, v in env.items():
        args += ["--env", f"{k}={v}"]
    for attempt in range(8):
        try:
            herdr(*args)
            return
        except CorralError as exc:
            if "busy" not in str(exc).lower() or attempt == 7:
                raise
            time.sleep(0.2)


def r_sessions() -> list[dict]:
    sessions = []
    for meta_file in (STATE_DIR / "sessions").glob("*/meta.json"):
        try:
            meta = json.loads(meta_file.read_text())
            os.kill(int(meta["pid"]), 0)
        except (OSError, ValueError, KeyError):
            continue
        meta["dir"] = str(meta_file.parent)
        meta.setdefault("lang", "r")
        sessions.append(meta)
    return sessions


def pick_session() -> dict | None:
    """The session for this place: CORRAL_SESSION, the active console, the workspace, the newest."""
    sessions = r_sessions()
    if not sessions:
        return None
    wanted = os.environ.get("CORRAL_SESSION")
    for s in sessions:
        if wanted and s.get("id") == wanted:
            return s
    if in_herdr():
        try:
            console = find_console(active_lang())
        except CorralError:
            console = None
        for s in sessions:
            if console and s.get("pane_id") == console:
                return s
        ws = current_workspace()
        same = [s for s in sessions if ws and s.get("workspace_id") == ws]
        sessions = same or sessions
    return max(sessions, key=lambda s: s.get("started") or 0)


def tui():
    sys.path.insert(0, str(REPO / "lib"))
    import corral_tui
    return corral_tui


def theme_module():
    sys.path.insert(0, str(REPO / "lib"))
    import corral_theme
    return corral_theme


def cmd_theme(args: argparse.Namespace) -> None:
    """Take herdr's theme and apply it to the editor, the viewers, VisiData and Mirador."""
    t = theme_module()
    p = t.apply() if not args.mostrar else t.palette()
    custom = t.herdr_theme()[1]
    print(f"tema de herdr: {p['name']}" + (f" (base {p['base']})" if p["base"] != p["name"] else "")
          + (f", con {len(custom)} colores propios" if custom else ""))
    if args.mostrar:
        for k in ("accent", "text", "muted", "dim", "selection", "green", "yellow", "red"):
            print(f"  {k:<10} {p[k]}")
        return
    print(f"paleta: {t.PALETTE_FILE}")
    print(f"tema de Fresh: {t.FRESH_THEME} (se ve al reiniciar el editor)")


def open_viewer(entrypoint: str, inline: bool) -> None:
    session = pick_session()
    if in_herdr() and not inline:
        open_popup(entrypoint, {"CORRAL_SESSION_DIR": session["dir"] if session else ""})
        return
    os.environ["CORRAL_SESSION_DIR"] = session["dir"] if session else ""
    (cmd_plots_tui if entrypoint == "plots" else cmd_vars_tui)(argparse.Namespace())


def cmd_plots(args: argparse.Namespace) -> None:
    """Plots of the R session of this workspace.

    Inside herdr on a terminal that draws images: a popup. Otherwise Mirador,
    brought to the front at the latest plot.
    """
    if args.inline or image_mode()[0] == "kitty":
        open_viewer("plots", args.inline)
        return
    session = pick_session()
    if not session:
        raise CorralError("no hay una sesión de R con Corral")
    show_latest_plot(Path(session["dir"]))


def show_latest_plot(session_dir: Path, wait: float = 0) -> None:
    """Open Mirador at the newest plot; wait a little for one to exist (R draws after opening the device)."""
    end = time.time() + wait
    while True:
        state = httpgd_state(session_dir)
        if state and state[2].get("hsize", 0) > 0:
            base, token, _ = state
            try:
                with urllib.request.urlopen(f"{base}/plots?token={token}", timeout=3) as r:
                    ids = [p["id"] for p in json.loads(r.read()).get("plots", [])]
            except (OSError, ValueError):
                ids = []
            if ids:
                open_plot(session_dir, ids[-1])
                return
        if time.time() >= end:
            notify("Sin gráficos", "Todavía no hay gráficos en esta sesión de R")
            return
        time.sleep(0.25)


def cmd_vars(args: argparse.Namespace) -> None:
    """Variables of the R session of this workspace (a popup inside herdr, or JSON)."""
    if args.json:
        try:
            session = console_session(args.lang)[1]
        except CorralError:
            session = None if args.lang else pick_session()
        if not session:
            raise CorralError(f"no hay una sesión de {LANG_NAMES.get(args.lang or 'r')} con Corral")
        return cmd_vars_json(session)
    if args.split:
        split_vars_pane()
        return
    if args.pane:
        tui().vars_viewer(resolve_session_dir(), run_in_console=run_in_pane,
                          resolve=resolve_session_dir, keep_open=True, open_plot=open_plot,
                          show_object=show_plot_object)
        return
    open_viewer("vars", args.inline)


def no_session_screen() -> None:
    tui().message_screen("No hay una sesión de R con Corral",
                         "Abre R en un panel de herdr (con corral.R en tu .Rprofile)\no usa ctrl+b a para armar el espacio de trabajo.")


def corral_config() -> dict:
    try:
        return json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        return {}


def herdr_client_terminals() -> list[str]:
    """Which terminal each attached herdr window runs in (from the client processes' environment)."""
    found = []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if (proc / "comm").read_text().strip() != "herdr":
                continue
            args = (proc / "cmdline").read_bytes().split(b"\0")[1:]
            args = [a.decode(errors="replace") for a in args if a]
            if args and not args[0].startswith("--"):  # server or a CLI call, not a window
                continue
            env = dict(item.split("=", 1) for item in
                       (proc / "environ").read_bytes().decode(errors="replace").split("\0") if "=" in item)
        except OSError:
            continue
        if "WEZTERM_PANE" in env or "WEZTERM_EXECUTABLE" in env:
            found.append("WezTerm")
        elif "KITTY_WINDOW_ID" in env:
            found.append("kitty")
        else:
            found.append(env.get("TERM_PROGRAM") or env.get("TERM") or "desconocida")
    return found


def image_mode() -> tuple[str, str]:
    """('kitty' | 'symbols', why). CORRAL_IMAGES or the config win; 'auto' looks at herdr's windows."""
    mode = os.environ.get("CORRAL_IMAGES") or corral_config().get("images") or "auto"
    if mode != "auto":
        return mode, "configurado"
    terms = herdr_client_terminals()
    kitty = any(k in t.lower() for t in terms for k in KITTY_TERMINALS)
    return ("kitty" if kitty else "symbols"), "ventanas de herdr: " + (", ".join(terms) or "ninguna")


def cmd_config(args: argparse.Namespace) -> None:
    cfg = corral_config()
    if args.value is None:
        print(json.dumps(cfg.get(args.key) if args.key else cfg, ensure_ascii=False))
        return
    allowed = {"images": {"auto", "kitty", "symbols"}, "mirador_window": {"derecha", "libre"},
               "ark_frontend": {"corral", "jupyter"}}
    if args.key in allowed and args.value not in allowed[args.key]:
        raise CorralError(f"{args.key} acepta: {', '.join(sorted(allowed[args.key]))}")
    cfg[args.key] = args.value
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=1, ensure_ascii=False))
    print(f"{args.key} = {args.value}")


def cmd_plots_tui(_: argparse.Namespace) -> None:
    d = os.environ.get("CORRAL_SESSION_DIR")
    if not d:
        return no_session_screen()
    images = image_mode()[0]
    tui().plots_viewer(Path(d), images=images, open_browser=lambda: open_mirador_window(ensure_mirador()),
                       start_id=os.environ.get("CORRAL_PLOT_ID") or None)


def run_in_pane(pane: str, code: str) -> bool:
    try:
        herdr("pane", "run", pane, code)
        return True
    except CorralError:
        return False


def resolve_session_dir() -> Path | None:
    """Session of the active console in this workspace; follows restarts and the R/Python switch."""
    try:
        return Path(console_session()[1]["dir"])
    except CorralError:
        try:
            if find_console(active_lang()):
                return None  # this workspace has a console, but R isn't running in it yet
        except CorralError:
            pass
        session = pick_session()
        return Path(session["dir"]) if session else None


def open_plot(session_dir: Path, plot_id: str) -> str:
    """Show one plot sharply: a herdr popup when the terminal draws images, else Mirador."""
    if image_mode()[0] == "kitty" and in_herdr():
        open_popup("plots", {"CORRAL_SESSION_DIR": str(session_dir), "CORRAL_PLOT_ID": plot_id})
        return "herdr"
    info = ensure_mirador()
    mirador_call(info, "/api/show-plot", {"session": session_dir.name, "id": plot_id})
    active = mirador_alive(info, need_window=True)
    if not active:
        open_app_window(f"{info['url']}#plot:{session_dir.name}:{plot_id}")
        mirador_call(info, "/api/opened", {})
    # Windows leaves windows opened from the background behind the active one.
    bring_to_front("Mirador", place=not active)
    return "Mirador"


def window_place() -> tuple[str, float, float]:
    """Where a new Mirador window goes: corral config mirador_window derecha|libre, mirador_size 0.5x0.85."""
    cfg = corral_config()
    mode = cfg.get("mirador_window", "derecha")
    try:
        w, h = (float(x) for x in str(cfg.get("mirador_size", "0.5x0.85")).lower().split("x"))
    except ValueError:
        w, h = 0.5, 0.85
    return ("right" if mode == "derecha" else ""), min(max(w, 0.2), 1.0), min(max(h, 0.2), 1.0)


def bring_to_front(title: str, wait: float = 8, find_only: bool = False, background: bool = True,
                   place: bool = False, dry_run: bool = False):
    """Raise the Windows window whose title starts with `title` (WSL only; best effort).

    Windows opens windows from background processes behind the active one, so
    after opening Mirador corral waits for its window and brings it forward.
    With place=True (new windows) it also un-maximizes it and puts it on the right.
    """
    if not (os.environ.get("WSL_DISTRO_NAME") and shutil.which("powershell.exe")):
        return None
    if os.environ.get("CORRAL_BROWSER") == "print" and not (find_only or dry_run):
        return None  # no windows are being opened, so none to raise
    import base64
    script = (REPO / "lib" / "front.ps1").read_text()
    args = f"-Prefix '{title}' -WaitSeconds {wait}" + (" -FindOnly" if find_only else "")
    where, fw, fh = window_place()
    if place and where:
        args += f" -Place {where} -Width {fw} -Height {fh}"
    if dry_run:
        args += f" -DryRun -Width {fw} -Height {fh}"
    command = f"& {{ {script} }} {args}"
    encoded = base64.b64encode(command.encode("utf-16-le")).decode()
    argv = ["powershell.exe", "-NoProfile", "-NonInteractive", "-EncodedCommand", encoded]
    if background:
        subprocess.Popen(argv, cwd="/mnt/c", stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True, env=windows_env())
        return None
    proc = subprocess.run(argv, cwd="/mnt/c", capture_output=True, timeout=wait + 20, env=windows_env())
    return (proc.stdout + proc.stderr).decode("utf-8", "replace").strip()


def httpgd_ids(session_dir: Path) -> list[str]:
    state = httpgd_state(session_dir)
    if not state:
        return []
    base, token, _ = state
    try:
        with urllib.request.urlopen(f"{base}/plots?token={token}", timeout=3) as r:
            return [p["id"] for p in json.loads(r.read()).get("plots", [])]
    except (OSError, ValueError):
        return []


def show_plot_object(session_dir: Path, name: str) -> str:
    """Show a plot object (ggplot, lattice, ...): reuse its drawing if it has one, else draw it."""
    try:
        meta = json.loads((session_dir / "meta.json").read_text())
        variables = json.loads((session_dir / "vars.json").read_text()).get("vars", [])
    except (OSError, ValueError):
        meta, variables = {}, []
    pane = meta.get("pane_id")
    if not pane:
        return "la sesión no está en un panel de herdr"
    fingerprint = next((v.get("hash") for v in variables if v.get("name") == name), None)
    map_file = session_dir / "plotobj-map.json"
    try:
        drawn = json.loads(map_file.read_text())
    except (OSError, ValueError):
        drawn = {}

    if fingerprint and drawn.get(fingerprint) in httpgd_ids(session_dir):
        open_plot(session_dir, drawn[fingerprint])
        return "ya estaba dibujado; abierto en Mirador"

    before = httpgd_state(session_dir)
    old = (before[2].get("hsize", 0), before[2].get("upid")) if before else (0, None)
    if meta.get("lang") == "python":
        code = f"_corral_show({name})"
    else:
        code = "print(`" + name.replace("`", "\\`") + "`)"
    if not run_in_pane(pane, code):
        return "no pude enviar a la consola"
    end = time.time() + 10
    while time.time() < end:
        time.sleep(0.25)
        state = httpgd_state(session_dir)
        if state and (state[2].get("hsize", 0), state[2].get("upid")) != old and state[2].get("hsize", 0) > 0:
            ids = httpgd_ids(session_dir)
            if fingerprint and ids:
                drawn[fingerprint] = ids[-1]
                map_file.write_text(json.dumps(drawn))
            show_latest_plot(session_dir)
            return "dibujado y abierto en Mirador"
    return "R no dibujó nada (¿sigue ocupado?)"


def cmd_vars_tui(_: argparse.Namespace) -> None:
    d = os.environ.get("CORRAL_SESSION_DIR")
    if not d:
        return no_session_screen()
    tui().vars_viewer(Path(d), run_in_console=run_in_pane, open_plot=open_plot, show_object=show_plot_object)


def split_vars_pane(console: str | None = None, ratio: float = 0.62) -> str:
    """Permanent variables pane under the R console, like Positron's Variables view."""
    console = console or find_console("r")
    if not console:
        raise CorralError("no hay consola corral:r en este workspace")
    for pane in list_panes(current_workspace()):
        if pane.get("label") == "corral:vars":
            notify("Variables", f"ya está abierto en {pane['pane_id']}")
            return pane["pane_id"]
    new = herdr("pane", "split", console, "--direction", "down", "--ratio", str(ratio), "--no-focus")["pane"]["pane_id"]
    herdr("pane", "rename", new, "corral:vars")
    herdr("pane", "run", new, f"{corral_command()} vars --pane")
    return new


def lintr_config_found(start: Path) -> bool:
    """Would lintr find a config of its own (project .lintr, ~/.lintr or its user config)?"""
    for folder in [start, *start.parents]:
        if (folder / ".lintr").is_file():
            return True
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return (Path.home() / ".lintr").is_file() or (config_home / "R" / "lintr" / "config").is_file()


def cmd_ark(args: argparse.Namespace) -> None:
    """Ark, Positron's R kernel, as Corral's R console: status, or install a version."""
    if args.instalar:
        version = args.instalar
        url = f"https://github.com/posit-dev/ark/releases/download/{version}/ark-{version}-linux-x64.zip"
        target = ARK_DIR / version
        target.mkdir(parents=True, exist_ok=True)
        print(f"descargando {url}")
        import io
        import zipfile
        with urllib.request.urlopen(url, timeout=120) as r:
            zipfile.ZipFile(io.BytesIO(r.read())).extractall(target)
        (target / "ark").chmod(0o755)
        print(f"Ark {version} instalado en {target}")
    ark = ark_binary()
    console = shutil.which("jupyter-console")
    print(f"Ark:             {ark or 'no instalado (corral ark --instalar ' + ARK_VERSION + ')'}")
    print(f"jupyter-console: {console or 'no instalado (opcional: corral config ark_frontend jupyter)'}")
    print(f"consola de R:    {r_flavor()}  (corral config r_console ark|r)")
    print(f"frente de Ark:   {'jupyter-console' if jupyter_frontend() else 'consola de Corral (Rust)'}")
    if ark:
        print(f"kernel:          {ark_kernelspec() / 'kernels' / 'ark' / 'kernel.json'}")


def ark_connection() -> str | None:
    """Connection file of the R console's Ark kernel: this workspace's, or one in this folder."""
    try:
        session = console_session("r")[1]
        if session.get("ark_connection") and Path(session["ark_connection"]).exists():
            return session["ark_connection"]
    except CorralError:
        pass
    here = Path.cwd().resolve()
    for s in sorted(r_sessions(), key=lambda s: -(s.get("started") or 0)):
        conn = s.get("ark_connection")
        if conn and Path(conn).exists() and (here == Path(s.get("cwd", "/")).resolve()
                                             or Path(s.get("cwd", "/")).resolve() in here.parents):
            return conn
    return None


def cmd_lsp(args: argparse.Namespace) -> None:
    """Language servers for the editor (completion, diagnostics).

    R: languageserver, with lintr reporting real problems only, like Positron
    (style is Air's job), unless the project brings its own .lintr.
    Python: python-lsp-server (completion, help, definitions) in the project's
    environment through uv; Ruff gives the diagnostics as a second server.
    """
    if args.lang == "python":
        os.execvp("uv", ["uv", "run", "--quiet", "--with", "python-lsp-server", "pylsp"])
    # R under Ark: Ark's own language server (it knows the live session), through
    # a small bridge. The editor may start before the console: wait for it.
    ark = ark_connection()
    if not ark and r_flavor() == "ark":
        end = time.time() + 60
        while not ark and time.time() < end:
            time.sleep(1)
            ark = ark_connection()
    if ark:
        bridge = str(REPO / "py" / "ark_lsp.py")
        console = shutil.which("jupyter-console")
        tool_python = Path(console).resolve().parent / "python" if console else None
        if tool_python and tool_python.exists():
            os.execv(str(tool_python), [str(tool_python), bridge, ark])
        os.execvp("uv", ["uv", "run", "--quiet", "--no-project", "--with", "jupyter-client", "python", bridge, ark])
    code = "languageserver::run()"
    if not lintr_config_found(Path.cwd()):
        code = f"options(lintr.linter_file = {json.dumps(str(REPO / 'lib' / 'corral.lintr'))}); {code}"
    os.execvp("R", ["R", "--no-echo", "--no-restore", "-e", code])


def cmd_plot_ready(_: argparse.Namespace) -> None:
    """First plot of an R session (called by corral.R)."""
    if image_mode()[0] == "kitty":
        notify("Gráfico listo", "ctrl+b f para verlo")
        return
    session = pick_session()
    if session:
        show_latest_plot(Path(session["dir"]), wait=6)


# --------------------------------------------------------------------------- eval (for agents)


def console_session(lang: str | None = None) -> tuple[str, dict]:
    """The console pane for `lang` (the active one by default) and the Corral session in it."""
    lang = lang or active_lang()
    console = find_console(lang)
    if not console:
        if lang == "python":
            raise CorralError("no hay consola de Python: se abre sola al ejecutar código de Python, o con ctrl+b y")
        raise CorralError(f"no hay consola {console_label(lang)} en herdr; ábrela con ctrl+b a o márcala con ctrl+b m")
    for s in r_sessions():
        if s.get("pane_id") == console:
            return console, s
    if lang == "python":
        raise CorralError(f"la consola {console} no tiene Corral activo (¿IPython sigue arrancando?)")
    raise CorralError(f"la consola {console} no tiene Corral activo: abre R con `CORRAL=1 R` o corre corral_activar() en ese R (ctrl+b m lo hace)")


def last_line(pane: str) -> str:
    hb = herdr_bin()
    proc = subprocess.run([hb, "pane", "read", pane, "--source", "visible"], capture_output=True, text=True)
    lines = [l.rstrip() for l in proc.stdout.splitlines() if l.strip()]
    return lines[-1] if lines else ""


def wait_for_prompt(pane: str, timeout: float, lang: str = "r") -> None:
    """Wait until the console shows an empty prompt; refuse half-typed input."""
    deadline = time.time() + timeout
    while True:
        line = last_line(pane)
        prompt = re.fullmatch(r"In \[\d+\]:\s*(.*)", line)  # IPython, or R through Ark
        if prompt or re.match(r"\s*\.\.\.:", line) or lang == "python":
            idle = bool(prompt) and not prompt.group(1).strip()
            half = bool(prompt and prompt.group(1).strip()) or bool(re.match(r"\s*\.\.\.:", line))
        else:
            idle = bool(re.fullmatch(r">\s*", line))
            half = line.startswith("+") or (line.startswith("> ") and bool(line[2:].strip()))
        if idle:
            return
        if half:
            if time.time() > deadline:
                raise CorralError("la consola tiene una línea a medio escribir; termínala o bórrala y vuelve a intentar")
        elif time.time() > deadline:
            raise CorralError(f"la consola de {LANG_NAMES.get(lang, lang)} está ocupada; espera a que termine o usa --wait-idle")
        time.sleep(0.25)


def httpgd_state(session_dir: Path) -> tuple[str, str, dict] | None:
    try:
        url = (session_dir / "plots-url").read_text().strip()
    except OSError:
        return None
    parsed = urllib.parse.urlparse(url)
    base = f"{parsed.scheme}://{parsed.netloc}"
    token = urllib.parse.parse_qs(parsed.query).get("token", [""])[0]
    try:
        with urllib.request.urlopen(f"{base}/state?token={token}", timeout=3) as r:
            return base, token, json.loads(r.read())
    except (OSError, ValueError):
        return None


def cmd_eval(args: argparse.Namespace) -> None:
    """Run R or Python code in the shared console and print what it printed (for agents)."""
    lang = args.lang
    if args.check:
        pane, session = console_session(lang)
        print(json.dumps({"console": pane, "lang": lang, "session": session["id"],
                          "version": session.get("python_version" if lang == "python" else "r_version"),
                          "cwd": session.get("cwd"), "active": active_lang() == lang}))
        return
    if args.code:
        code = " ".join(args.code)
    elif args.file:
        code = Path(args.file).read_text()
    elif not sys.stdin.isatty():
        code = sys.stdin.read()
    else:
        raise CorralError("pasa el código como argumento, con --file o por stdin")
    if not code.strip():
        raise CorralError("no hay código que ejecutar")

    pane, started = show_console(lang)
    if not started:  # just opened: it is still starting, not quit
        started = ensure_running(pane, lang)
    if started:
        wait_for_prompt(pane, 180, lang)
    pane, session = console_session(lang)
    sdir = Path(session["dir"])
    edir = sdir / "eval"
    edir.mkdir(parents=True, exist_ok=True)

    # One request at a time per console, so several agents queue instead of interleaving.
    lock = open(edir / ".lock", "w")
    give_up = time.time() + args.wait_idle + args.timeout
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.time() > give_up:
                raise CorralError("otra petición sigue corriendo en esta consola")
            time.sleep(0.2)

    wait_for_prompt(pane, args.wait_idle, lang)
    rid = time.strftime("%H%M%S") + "-" + secrets.token_hex(3)
    ext = ".py" if lang == "python" else ".R"
    (edir / f"{rid}{ext}").write_text(code if code.endswith("\n") else code + "\n", encoding="utf-8")
    # If R only gets to it after the agent gave up, it must not run.
    (edir / f"{rid}.deadline").write_text(str(time.time() + args.timeout))
    before = httpgd_state(sdir)
    herdr("pane", "run", pane, f'_corral_eval("{rid}")' if lang == "python" else f'.corral_eval("{rid}")')

    result_file, out_file = edir / f"{rid}.json", edir / f"{rid}.out"
    end = time.time() + args.timeout
    while not result_file.exists() and time.time() < end:
        time.sleep(0.15)
    output = out_file.read_text(encoding="utf-8", errors="replace") if out_file.exists() else ""

    if not result_file.exists():
        print(clip_output(output, args.max_chars, out_file))
        print(f"\n[corral] sigue corriendo después de {args.timeout:.0f} s; la salida completa quedará en {out_file}")
        sys.exit(2)
    try:
        result = json.loads(result_file.read_text())
    except ValueError:
        result = {"status": result_file.read_text().strip()}

    print(clip_output(output.rstrip(), args.max_chars, out_file))
    for w in result.get("warnings") or []:
        print(f"[corral] advertencia: {w}")
    if result.get("status") == "expired":
        print("[corral] la petición venció antes de ejecutarse")
        sys.exit(2)

    after = httpgd_state(sdir)
    if after:
        base, token, state = after
        old = (before[2].get("hsize", 0) if before else 0)
        new = state.get("hsize", 0)
        changed = before is None or state.get("upid") != before[2].get("upid")
        indexes = list(range(old, new)) or ([new - 1] if changed and new else [])
        current = httpgd_ids(sdir)
        drawn = [current[i] for i in indexes if i < len(current)]
        # The plots of the previous eval, so a corrected version can replace them.
        last_file = edir / "ultimos-graficos.json"
        removed = 0
        if args.reemplazar and drawn:
            try:
                previous = json.loads(last_file.read_text()).get("ids", [])
            except (OSError, ValueError):
                previous = []
            removed = remove_plots(sdir, [i for i in previous if i not in drawn])
            current = httpgd_ids(sdir)
        if drawn:
            last_file.write_text(json.dumps({"rid": rid, "ids": drawn}))
        for plot_id in drawn:
            number = current.index(plot_id) + 1 if plot_id in current else 0
            png = edir / f"{rid}-plot-{number}.png"
            try:
                with urllib.request.urlopen(f"{base}/plot?id={plot_id}&width=900&height=600&renderer=png&token={token}", timeout=10) as r:
                    png.write_bytes(r.read())
                print(f"[corral] gráfico {number} guardado en {png} (ctrl+b f para verlo en herdr)")
            except OSError:
                pass
        if removed:
            print(f"[corral] reemplazó {removed} gráfico(s) de la petición anterior; el usuario ve solo la versión nueva")
    sys.exit(1 if result.get("status") == "error" else 0)


def remove_plots(session_dir: Path, ids: list[str]) -> int:
    """Remove plots from the session's httpgd history by id; returns how many went."""
    removed = 0
    for plot_id in ids:
        state = httpgd_state(session_dir)
        current = httpgd_ids(session_dir)
        if not state or plot_id not in current:
            continue
        base, token, _ = state
        try:
            with urllib.request.urlopen(f"{base}/remove?index={current.index(plot_id)}&token={token}", timeout=5):
                removed += 1
        except OSError:
            pass
    return removed


def clip_output(text: str, limit: int, full: Path) -> str:
    if len(text) <= limit:
        return text
    head = text[: limit // 2]
    tail = text[-limit // 2:]
    return f"{head}\n\n[corral] … salida recortada ({len(text)} caracteres); completa en {full} …\n\n{tail}"


def cmd_vars_json(session: dict) -> None:
    try:
        data = json.loads((Path(session["dir"]) / "vars.json").read_text())
    except (OSError, ValueError):
        raise CorralError("esta sesión no publica variables (¿falta jsonlite?)")
    print(json.dumps({"session": session["id"], "lang": session.get("lang", "r"), "console": session.get("pane_id"),
                      "vars": data.get("vars", [])}, ensure_ascii=False, indent=1))


# --------------------------------------------------------------------------- Mirador


def mirador_info() -> dict:
    try:
        return json.loads(MIRADOR_INFO.read_text())
    except (OSError, ValueError):
        return {}


def mirador_call(info: dict, path: str, body: dict | None = None, timeout: float = 3) -> dict:
    url = f"http://127.0.0.1:{info['port']}{path}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, headers={"X-Corral-Token": info["token"], "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"{}")
    except OSError as exc:
        raise CorralError(f"Mirador no responde ({exc})") from exc


def mirador_alive(info: dict | None = None, need_window: bool = False) -> bool:
    """Is the server up? With need_window, is a Mirador page also polling it?"""
    info = info or mirador_info()
    if not info.get("pid") or not info.get("port"):
        return False
    try:
        os.kill(int(info["pid"]), 0)
        ping = mirador_call(info, "/api/ping", timeout=1.5)
    except (OSError, CorralError, ValueError):
        return False
    return bool(ping.get("active")) if need_window else bool(ping.get("ok"))


def ensure_mirador() -> dict:
    info = mirador_info()
    if mirador_alive(info):
        return info
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(STATE_DIR / "mirador.log", "ab")
    subprocess.Popen(
        mirador_command(), stdin=subprocess.DEVNULL, stdout=log, stderr=log,
        start_new_session=True, cwd=str(REPO),
    )
    old_pid = info.get("pid")
    deadline = time.time() + 6
    while time.time() < deadline:
        time.sleep(0.15)
        info = mirador_info()
        if info.get("pid") and info.get("pid") != old_pid and mirador_alive(info):
            return info
    raise CorralError(f"Mirador no arrancó; revisa {STATE_DIR / 'mirador.log'}")


def open_mirador_window(info: dict) -> None:
    open_app_window(info["url"])
    try:
        mirador_call(info, "/api/opened", {})  # avoids a second window while the page loads
    except CorralError:
        pass
    bring_to_front("Mirador", place=True)


def cmd_mirador(args: argparse.Namespace) -> None:
    """Start Mirador if needed and open its window unless one is already open."""
    if args.stop:
        info = mirador_info()
        if info.get("pid") and mirador_alive(info):
            os.kill(int(info["pid"]), 15)
            print("Mirador detenido")
        else:
            print("Mirador no estaba corriendo")
        return
    if args.foreground:
        command = mirador_command()
        os.execv(command[0], command)
    info = ensure_mirador()
    if args.url:
        print(info["url"])
        return
    if args.open or not mirador_alive(info, need_window=True):
        open_mirador_window(info)


def windows_env() -> dict:
    """Environment for launching Windows programs from WSL.

    WSL starts .exe files through the interop socket named in WSL_INTEROP. A
    long-lived process (the herdr server and its panes) keeps the socket of the
    terminal that started it, which disappears when that terminal closes. Fall
    back to a socket that is still alive.
    """
    env = dict(os.environ)
    current = env.get("WSL_INTEROP")
    if current and Path(current).exists():
        return env
    candidates = [Path("/run/WSL/1_interop")] + sorted(Path("/run/WSL").glob("*_interop"),
                                                       key=lambda p: p.stat().st_mtime if p.exists() else 0,
                                                       reverse=True)
    for c in candidates:
        if c.exists():
            env["WSL_INTEROP"] = str(c)
            break
    return env


def browser_argv(url: str) -> list[str] | None:
    """Command that opens `url`, or None when it should only be printed.

    CORRAL_BROWSER: firefox | edge | chrome | print | a command (`{url}` is replaced).
    """
    choice = os.environ.get("CORRAL_BROWSER", "").strip()
    if choice == "print":
        return None
    if choice and choice not in WINDOWS_BROWSERS:
        argv = [a.replace("{url}", url) for a in shlex.split(choice)]
        return argv if "{url}" in choice else argv + [url]
    if os.environ.get("WSL_DISTRO_NAME"):
        for name in [choice] if choice else list(WINDOWS_BROWSERS):
            paths, args = WINDOWS_BROWSERS[name]
            exe = next((p for p in paths if Path(p).exists()), None)
            if exe:
                # Call the .exe directly so cmd.exe never parses the '&' in httpgd's token URL.
                return [exe] + [a.replace("{url}", url) for a in args]
    if shutil.which("xdg-open"):
        return ["xdg-open", url]
    return None


def open_app_window(url: str) -> None:
    argv = browser_argv(url)
    if not argv:
        print(url)
        return
    cwd = "/mnt/c" if argv[0].startswith("/mnt/") else None
    subprocess.Popen(
        argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True, env=windows_env(),
    )


def cmd_doctor(_: argparse.Namespace) -> None:
    rows: list[tuple[bool, str, str]] = []

    def check(ok: bool, name: str, detail: str = "") -> None:
        rows.append((ok, name, detail))

    hb = herdr_bin()
    check(bool(hb), "herdr", hb or "no está en el PATH")
    check(in_herdr(), "dentro de herdr", "sí" if in_herdr() else "no (corral funciona igual, sin paneles)")
    if hb:
        try:
            plugins = herdr("plugin", "list", "--json").get("plugins", [])
            linked = any(p.get("id") == PLUGIN_ID or p.get("plugin_id") == PLUGIN_ID for p in plugins)
            check(linked, "plugin enlazado", "sí" if linked else f"herdr plugin link {SCRIPT.parent.parent / 'herdr'}")
        except CorralError as exc:
            check(False, "plugin enlazado", str(exc))

    uv = shutil.which("uv")
    check(bool(uv), "uv (consola de Python)", uv or "no está en el PATH; https://docs.astral.sh/uv/")
    ark = ark_binary()
    check(bool(ark), "Ark (consola de R)", str(ark) if ark else f"corral ark --instalar  (sin Ark, la consola es R normal)")
    console = shutil.which("jupyter-console")
    if jupyter_frontend():
        check(bool(console), "jupyter-console (para Ark)", console or "uv tool install jupyter-console")
    check(True, "consola de R", "Ark" if r_flavor() == "ark" else "R normal (corral config r_console)")
    rscript = shutil.which("Rscript")
    check(bool(rscript), "R", rscript or "no está en el PATH")
    if rscript:
        pkgs = ["httpgd", "jsonlite", "arrow", "nanoparquet"]
        probe = f'cat(sapply(c({",".join(repr(p) for p in pkgs)}), requireNamespace, quietly = TRUE))'
        res = subprocess.run([rscript, "--vanilla", "-e", probe], capture_output=True, text=True)
        has = dict(zip(pkgs, [f == "TRUE" for f in res.stdout.split()]))
        check(has.get("httpgd", False), "R: httpgd", "gráficos")
        check(has.get("jsonlite", False), "R: jsonlite", "variables en Mirador")
        parquet = next((p for p in ("arrow", "nanoparquet") if has.get(p)), None)
        check(bool(parquet), "R: parquet", parquet or "instala nanoparquet o arrow; mientras tanto View() usa CSV")

    try:
        t = theme_module()
        pal, applied = t.palette(), t.load()
        check(bool(applied) and applied.get("name") == pal["name"], "tema",
              f"{pal['name']} desde herdr" + ("" if applied and applied.get("name") == pal["name"] else "; corre `corral theme`"))
    except Exception as exc:
        check(False, "tema", str(exc))

    mode, why = image_mode()
    check(mode == "kitty", "gráficos en herdr", f"{'nítidos (Kitty)' if mode == 'kitty' else 'con caracteres'}; {why}")

    vd = shutil.which("vd")
    check(bool(vd), "VisiData", vd or "opcional; sin él uso duckdb + less")
    duck = shutil.which("duckdb")
    check(bool(duck), "DuckDB", duck or "no está en el PATH")
    browser = browser_argv("URL")
    shown = " ".join([Path(browser[0]).name, *browser[1:]]) if browser else "solo muestra la URL (CORRAL_BROWSER)"
    check(bool(browser), "ventana de gráficos", shown)
    info = mirador_info()
    up = mirador_alive(info)
    check(True, "Mirador", info.get("url", "") if up else "detenido; se inicia con el primer gráfico o con `corral mirador`")

    width = max(len(r[1]) for r in rows)
    for ok, name, detail in rows:
        print(f"{'✓' if ok else '✗'} {name.ljust(width)}  {detail}")


# --------------------------------------------------------------------------- main


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(prog="corral", description="Consolas de R y Python, tablas y gráficos junto a tus agentes.")
    parser.add_argument("--version", action="version", version=f"corral {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True,
                                metavar="{layout,close,send,eval,toggle,switch,script,console,plots,vars,view,mirador,open,ark,theme,config,doctor}")

    p = sub.add_parser("layout", help="abre una pestaña con agente, consola de R y shell")
    p.add_argument("--cwd")
    p.add_argument("--label", default="corral")
    p.add_argument("--agent", default=os.environ.get("CORRAL_AGENT", "claude"), help="comando del panel izquierdo ('' para dejar shell)")
    p.add_argument("--console", default=os.environ.get("CORRAL_R"),
                   help="comando de la consola de R (por defecto Ark si está instalado; si no, R)")
    p.add_argument("--ratio", type=float, default=0.516, help="fracción del ancho para el panel del agente")
    p.add_argument("--shell", action="store_true", help="agregar una shell junto al panel de variables")
    p.add_argument("--editor", default=os.environ.get("CORRAL_EDITOR", "fresh"), help="editor del panel de script ('' sin script)")
    p.set_defaults(func=cmd_layout)

    p = sub.add_parser("close", help="cierra script, consola y variables de esta pestaña; deja a Claude")
    p.set_defaults(func=cmd_close)

    p = sub.add_parser("toggle", help="expande el script o la consola a toda la zona, o muestra ambos (ctrl+b t)")
    p.add_argument("mode", nargs="?", choices=list(TOGGLE_NAMES),
                   help="ambos, script o consola; sin valor, expande el panel donde estás o vuelve a ambos")
    p.set_defaults(func=cmd_toggle)

    p = sub.add_parser("script", help="agrega el editor de scripts sobre la consola")
    p.add_argument("file", nargs="?")
    p.add_argument("--split", action="store_true", help="(por defecto) abrir el panel sobre la consola")
    p.add_argument("--guardar", metavar="RUTA", help="guardar el borrador (con lo no guardado) en RUTA")
    p.add_argument("--leer", action="store_true", help="imprimir el contenido actual del borrador")
    p.add_argument("--forzar", action="store_true", help="con --guardar, reemplazar si RUTA existe")
    p.add_argument("--editor", default=os.environ.get("CORRAL_EDITOR", "fresh"))
    p.set_defaults(func=cmd_script)

    p = sub.add_parser("console", help="marca un panel como consola de R o Python (según lo que corre en él)")
    p.add_argument("--pane")
    p.add_argument("--lang", choices=list(LANG_NAMES))
    p.set_defaults(func=cmd_console)

    p = sub.add_parser("switch", help="la consola del layout pasa a R o a Python (ctrl+b y); sin valor, alterna")
    p.add_argument("lang", nargs="?", choices=list(LANG_NAMES))
    p.set_defaults(func=cmd_switch)

    p = sub.add_parser("send", help="envía código a la consola (argumentos, stdin, selección o portapapeles)")
    p.add_argument("text", nargs="*")
    p.add_argument("--lang", choices=list(LANG_NAMES), help="r o python; por defecto, la consola activa")
    p.add_argument("--clipboard", action="store_true", help="usar el portapapeles si no hay otro texto")
    p.add_argument("--source", action="store_true",
                   help="ejecutar como archivo: source(echo = TRUE) en R, %%run -i en Python")
    p.add_argument("--name", help="nombre del archivo, para mostrarlo en la consola")
    p.set_defaults(func=cmd_send)

    p = sub.add_parser("view", help="abre una tabla (parquet, csv, …) en un popup o en esta terminal")
    p.add_argument("file")
    p.add_argument("--title")
    p.add_argument("--inline", action="store_true", help="abrir aquí aunque esté dentro de herdr")
    p.add_argument("--session", help="sesión de R de origen (la pone corral.R)")
    p.set_defaults(func=cmd_view)

    p = sub.add_parser("mirador", help="abre Mirador: agentes, variables, gráficos y tablas")
    p.add_argument("--open", action="store_true", help="abrir una ventana aunque ya haya una")
    p.add_argument("--url", action="store_true", help="solo mostrar la URL")
    p.add_argument("--stop", action="store_true", help="detener el servidor")
    p.add_argument("--foreground", action="store_true", help="correr el servidor en esta terminal")
    p.set_defaults(func=cmd_mirador)

    p = sub.add_parser("plots", help="visor de gráficos de la sesión de R (popup dentro de herdr)")
    p.add_argument("--inline", action="store_true", help="abrir aquí aunque esté dentro de herdr")
    p.set_defaults(func=cmd_plots)

    p = sub.add_parser("vars", help="variables de la sesión activa (popup dentro de herdr)")
    p.add_argument("--lang", choices=list(LANG_NAMES), help="con --json: r o python (por defecto, la consola activa)")
    p.add_argument("--inline", action="store_true", help="abrir aquí aunque esté dentro de herdr")
    p.add_argument("--json", action="store_true", help="imprimir las variables en JSON (para agentes)")
    p.add_argument("--split", action="store_true", help="abrir un panel fijo de variables bajo la consola")
    p.add_argument("--pane", action="store_true", help="correr el visor fijo en esta terminal (lo usa --split)")
    p.set_defaults(func=cmd_vars)

    p = sub.add_parser("eval", help="ejecuta código en la consola de R o Python compartida e imprime el resultado (para agentes)")
    p.add_argument("code", nargs="*")
    p.add_argument("--lang", choices=list(LANG_NAMES), default="r", help="r (por defecto) o python")
    p.add_argument("--file", help="archivo a ejecutar")
    p.add_argument("--timeout", type=float, default=300, help="segundos máximos de espera (300)")
    p.add_argument("--wait-idle", type=float, default=20, help="segundos esperando que la consola se desocupe (20)")
    p.add_argument("--max-chars", type=int, default=20000, help="recorta salidas más largas (20000)")
    p.add_argument("--check", action="store_true", help="solo verificar que hay consola y sesión")
    p.add_argument("--reemplazar", action="store_true",
                   help="los gráficos que dibuje reemplazan a los de la petición anterior (para corregir un gráfico)")
    p.set_defaults(func=cmd_eval)

    p = sub.add_parser("open", help="abre una URL local en el navegador; sin URL, abre Mirador")
    p.add_argument("url", nargs="?")
    p.set_defaults(func=cmd_open)

    for name, func in (("_plots", cmd_plots_tui), ("_vars", cmd_vars_tui), ("_plot-ready", cmd_plot_ready)):
        sub.add_parser(name, help=argparse.SUPPRESS).set_defaults(func=func)
    p = sub.add_parser("ark", help="Ark (el kernel de R de Positron) como consola de R: estado o instalación")
    p.add_argument("--instalar", nargs="?", const=ARK_VERSION, metavar="VERSION",
                   help=f"descargar e instalar Ark (por defecto {ARK_VERSION}, la versión probada)")
    p.set_defaults(func=cmd_ark)

    p = sub.add_parser("_show-object", help=argparse.SUPPRESS)
    p.add_argument("session_dir")
    p.add_argument("name")
    p.set_defaults(func=lambda a: print(show_plot_object(Path(a.session_dir), a.name)))

    p = sub.add_parser("_console", help=argparse.SUPPRESS)
    p.add_argument("lang", choices=list(LANG_NAMES))
    p.set_defaults(func=cmd_console_run)

    p = sub.add_parser("_lsp", help=argparse.SUPPRESS)
    p.add_argument("lang", nargs="?", choices=list(LANG_NAMES), default="r")
    p.set_defaults(func=cmd_lsp)

    p = sub.add_parser("theme", help="aplica el tema de herdr al editor, los visores, VisiData y Mirador")
    p.add_argument("--mostrar", action="store_true", help="solo mostrar la paleta, sin aplicarla")
    p.set_defaults(func=cmd_theme)

    p = sub.add_parser("config", help="lee o cambia la configuración (por ejemplo: corral config images kitty)")
    p.add_argument("key", nargs="?")
    p.add_argument("value", nargs="?")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("doctor", help="revisa dependencias y estado")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("_table", help=argparse.SUPPRESS)
    p.add_argument("file", nargs="?")
    p.set_defaults(func=cmd_table)

    args = parser.parse_args(argv)
    try:
        args.func(args)
    except CorralError as exc:
        notify("Error", str(exc))
        sys.exit(1)


if __name__ == "__main__":
    main()
